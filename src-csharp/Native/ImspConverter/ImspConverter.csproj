<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Globals\Globals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <OutputType>Library</OutputType>
    <!-- mzLib is not AOT-annotated; suppress trim warnings from its assemblies -->
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Readers">
      <HintPath>..\..\lib\mzLib\Readers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MassSpectrometry">
      <HintPath>..\..\lib\mzLib\MassSpectrometry.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MzLibUtil">
      <HintPath>..\..\lib\mzLib\MzLibUtil.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Chemistry">
      <HintPath>..\..\lib\mzLib\Chemistry.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Transcriptomics">
      <HintPath>..\..\lib\mzLib\Transcriptomics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UsefulProteomicsDatabases">
      <HintPath>..\..\lib\mzLib\UsefulProteomicsDatabases.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.BackgroundSubtraction">
      <HintPath>..\..\lib\mzLib\ThermoFisher.CommonCore.BackgroundSubtraction.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.Data">
      <HintPath>..\..\lib\mzLib\ThermoFisher.CommonCore.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.MassPrecisionEstimator">
      <HintPath>..\..\lib\mzLib\ThermoFisher.CommonCore.MassPrecisionEstimator.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.RawFileReader">
      <HintPath>..\..\lib\mzLib\ThermoFisher.CommonCore.RawFileReader.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>..\..\..\natives\System.Data.SQLite.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
